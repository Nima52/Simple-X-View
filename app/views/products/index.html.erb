# This is a ERB which is short for Embedded Ruby and allows us to execute Ruby code to dynamically generate HTML with Rails
<h1>Products</h1>

<%= link_to "New product", new_product_path %>

<div id="products">
  <% @products.each do |product| %>
    <div>
      <%= link_to product.name, product_path(product.id) %>
    </div>
  <% end %>
</div>





