# ---------------------------------------------------------------------------
# Rails & Ruby Basic Ignores
# ---------------------------------------------------------------------------

# Ignore bundler config
/.bundle

# Ignore all environment files (API keys, secrets, etc.)
/.env*
!/.env.example

# Ignore logs and temp files
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# PID files
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Cache and storage (uploaded files in development)
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Rails compiled assets
/public/assets
/public/packs
/public/packs-test
/node_modules
/yarn-error.log

# Ignore key files for decrypting credentials
/config/master.key
/config/credentials/*.key

# Ignore SQLite databases (if using SQLite in dev/test)
/db/*.sqlite3
/db/*.sqlite3-journal

# Ignore schema cache (auto-generated)
/db/schema_cache.yml

# ---------------------------------------------------------------------------
# Tests & Coverage
# ---------------------------------------------------------------------------

/coverage/
spec/examples.txt

# ---------------------------------------------------------------------------
# Byebug / Pry history
# ---------------------------------------------------------------------------

.byebug_history
.pry_history

# ---------------------------------------------------------------------------
# Ruby / Bundler / Gems
# ---------------------------------------------------------------------------

/vendor/bundle/
/vendor/cache/
/vendor/ruby/
/Gemfile.lock
# (Optionally keep Gemfile.lock if you want to lock versions for deployments)
# Uncomment the line above if you prefer to include it

# ---------------------------------------------------------------------------
# Node / JS / CSS Tooling (Webpacker, jsbundling-rails, cssbundling-rails)
# ---------------------------------------------------------------------------

/node_modules/
/yarn-error.log
/package-lock.json
/npm-debug.log*
/pnpm-lock.yaml
/bun.lockb

# ---------------------------------------------------------------------------
# IDE & Editor files
# ---------------------------------------------------------------------------

# VSCode
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# RubyMine / JetBrains
.idea/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Other editor junk
*~
*.swp
*.swo
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Docker & Deployment
# ---------------------------------------------------------------------------

/docker-compose.override.yml
/.dockerignore
/tmp/docker/*
/tmp/deploy/*
/tmp/builds/*

# ---------------------------------------------------------------------------
# System / Misc
# ---------------------------------------------------------------------------

/coverage/
/spec/examples.txt
/.rspec_status
/annotation_files/
